modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 1935
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5199
externalPort = 3001

[env]
PORT = "5000"

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "manual-payment-regressions"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "manual-payment-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check && NODE_ENV=development WALLET_COIN_PURCHASE_DB_TEST=1 PAYMENT_PROOF_DB_TEST=1 npx tsx --test server/manual-payment.test.ts server/manual-payment.integration.test.ts server/ai-media-jobs.integration.test.ts server/replit_integrations/image/routes.test.ts server/payment-proof.test.ts server/walletCoinPurchase.integration.test.ts server/giftReceipt.integration.test.ts server/afsSandbox.test.ts client/src/lib/manual-payment-ui-contract.test.ts client/src/lib/live-privacy.test.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_openai_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000

[userenv]

[userenv.shared]
PASSWORD_RESET_EMAIL_FROM = "noreply@ads-as.com"
