# Copy this file to .env and fill in real values for local development.
# On Replit / VPS these are injected by the platform — .env is only for local.

# Postgres connection string. For managed hosts (Neon/Replit/Supabase)
# you usually need ?sslmode=require at the end.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

NODE_ENV=development
PORT=5000

# Optional: AI features (only needed if you use them locally)
# OPENAI_API_KEY=sk-...
# DID_API_KEY=...
