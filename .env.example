# ─────────────────────────────────────────────────────────────────────
# Souq Ads Network — Environment Variables Template
# Copy this file to .env on the VPS and fill in the real values.
# On Replit these are injected automatically by the platform.
# ─────────────────────────────────────────────────────────────────────

# ── Required: Database ──────────────────────────────────────────────
# Postgres connection string. For managed hosts (Neon/Supabase) add
# ?sslmode=require at the end. For local/VPS postgres without SSL, omit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Required: Session ───────────────────────────────────────────────
# Random string ≥ 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Required: Runtime ───────────────────────────────────────────────
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ── Required: Admin user ID ────────────────────────────────────────
# The user.id of the master admin account (used by isAdminUser check).
# Get it from: SELECT id FROM users WHERE email = 'your-email';
ADMIN_USER_ID=

# ── AI Features (OpenAI) ───────────────────────────────────────────
# Either set OPENAI_API_KEY directly, or use Replit AI Integrations vars.
OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Optional: Google Gemini ────────────────────────────────────────
GEMINI_API_KEY=

# ── Optional: D-ID (avatar video generation) ──────────────────────
DID_API_KEY=

# ── Optional: Replit OIDC (only on Replit, ignore on VPS) ─────────
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc

# ─────────────────────────────────────────────────────────────────────
# Wallet & Payment features:
#   No extra env vars needed — wallet phone numbers (Vodafone Cash etc)
#   are stored in the platform_settings DB table and editable from the
#   admin panel under "إدارة الأسعار" / "إعدادات المنصة".
#
# Deploy button (POST /api/admin/system-deploy):
#   No env vars needed — uses git + pm2 from system PATH.
#   Make sure git credential helper is configured (vps-setup.sh does it).
# ─────────────────────────────────────────────────────────────────────
