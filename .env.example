# ─────────────────────────────────────────────────────────────────────
# Souq Ads Network — Environment Variables Template
# Copy this file to .env on the VPS and fill in the real values.
# On Replit these are injected automatically by the platform.
# ─────────────────────────────────────────────────────────────────────

# ── Required: Database ──────────────────────────────────────────────
# Postgres connection string. For managed hosts (Neon/Supabase) add
# ?sslmode=require at the end. For local/VPS postgres without SSL, omit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Required: Session ───────────────────────────────────────────────
# Random string ≥ 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Dedicated AES-256-GCM key for admin-managed integration secrets. Required
# before saving vault values; use exactly 32 random bytes encoded as hex/base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_VAULT_MASTER_KEY=
# Separate random key used to HMAC password-reset OTPs and proofs (>= 32 chars).
PASSWORD_RESET_HMAC_SECRET=
# Optional dedicated RTMP signing secret. If omitted, SESSION_SECRET is used.
RTMP_AUTH_SECRET=

# ── Required: Runtime ───────────────────────────────────────────────
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
# Startup DDL is enabled for non-production development only. Keep this 0 in
# production; use the explicit reviewed deployment migration instead.
# RUN_STARTUP_MIGRATIONS=0
# RTMP ingest port (defaults to 1935).
RTMP_PORT=1935

# ── Required: Admin user ID ────────────────────────────────────────
# The user.id of the master admin account (used by isAdminUser check).
# Get it from: SELECT id FROM users WHERE email = 'your-email';
ADMIN_USER_ID=

# ── AI Features (OpenAI) ───────────────────────────────────────────
# Either set OPENAI_API_KEY directly, or use Replit AI Integrations vars.
OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Optional: Google Gemini ────────────────────────────────────────
GEMINI_API_KEY=

# ── Required for production card payments (AFS COPYandPAY) ─────────
# Production must use the production URL and production credentials.
# The server intentionally refuses the AFS test endpoint in NODE_ENV=production.
AFS_BASE_URL=https://eu-prod.oppwa.com
AFS_ENTITY_ID=
AFS_ACCESS_TOKEN=

# ── Optional: D-ID (avatar video generation) ──────────────────────
DID_API_KEY=

# ── Optional: Replit OIDC (only on Replit, ignore on VPS) ─────────
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc

# ── Password recovery delivery ─────────────────────────────────────
# Secret API key created in Resend. Store the real value in Replit Secrets.
RESEND_API_KEY=
# This non-secret value must be a sender verified in that Resend account.
PASSWORD_RESET_EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────
# Wallet & manual-payment features:
#   Wallet phone numbers (Vodafone Cash etc) are stored in the
#   platform_settings DB table and editable from the admin panel.
#
# ── Deployment operator variables (set in trusted CI/operator shell only) ──
# The admin-panel deployment endpoint is intentionally disabled. Use
# scripts/deploy.sh with all of these explicit values and a pinned known_hosts
# file; do not place SSH private keys in this file.
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_ROOT=/var/www/ads-as
# DEPLOY_SSH_KEY=/absolute/path/to/key
# DEPLOY_KNOWN_HOSTS=/absolute/path/to/known_hosts
# DEPLOY_PM2_APP=ads-as
# DEPLOY_HEALTH_URL=https://your-domain.example/api/health
# Keep only this many releases (default 5).
# Must be at least 2; active and previous releases are never pruned.
# DEPLOY_KEEP_RELEASES=5
# Post-merge never deploys unless this exact opt-in is set.
# DEPLOY_AFTER_MERGE=0
# Application deploy and post-merge never migrate the database. To apply
# reviewed, versioned migrations separately, run scripts/migrate-production.sh
# with MIGRATE_PRODUCTION_CONFIRM=YES and DATABASE_URL set in the operator shell.
# The migration script creates a backup but never restores it automatically.
# One-time existing-VPS baseline adoption only (see migrations/README.md):
# MIGRATE_BASELINE_EXISTING=YES
# MIGRATIONS_DIR=./migrations
# MIGRATION_BACKUP_DIR=./backups
#
# Host bootstrap variables for scripts/vps-setup.sh (also operator-shell only):
# APP_DOMAIN=your-domain.example
# APP_ROOT=/var/www/ads-as
# DEPLOY_USER=ads-as
# SSH_PORT=22
# ENABLE_SSL=0
# CERTBOT_EMAIL=ops@your-domain.example
# ALLOW_RTMP=0
# ─────────────────────────────────────────────────────────────────────
